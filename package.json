{
  "name": "@ghostry/aster",
  "version": "0.0.1",
  "license": "MIT",
  "description": "One grammar, two outputs: a RegExp for validation and a parser that returns a typed AST.",
  "keywords": [
    "grammar",
    "regex",
    "parser",
    "ast",
    "typescript"
  ],
  "author": {
    "name": "Patrick Rebsch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostry-dev/aster"
  },
  "homepage": "https://docs.ghostry.dev/aster",
  "bugs": "https://github.com/ghostry-dev/aster/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "types": "./dist/types/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./unstable-ir": {
      "types": "./dist/types/IR/index.d.ts",
      "import": "./dist/esm/IR/index.js",
      "default": "./dist/esm/IR/index.js"
    }
  },
  "imports": {
    "#internal/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/esm/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:reset": "rm -rf ./dist",
    "build:compile": "bunx --no-install --bun rslib build --config ./rslib.config.ts",
    "build:compile:rsdoctor": "RSDOCTOR=true bunx --no-install --bun rslib build --config ./rslib.config.ts",
    "build:types": "bun --bun ./node_modules/typescript-5/lib/tsc.js -p ./tsconfig.build.json --noEmit false --declaration --emitDeclarationOnly --declarationDir ./dist/types",
    "build:verify": "tsc --noEmit -p ./tsconfig.verify.json",
    "build:clean": "find ./dist -type f -name '*.tsbuildinfo' -delete",
    "build": "bun run build:reset && bun run build:compile && bun run build:types && bun run build:verify && bun run build:clean",
    "build:rsdoctor": "bun run build:reset && bun run build:compile:rsdoctor && bun run build:types && bun run build:verify && bun run build:clean",
    "typecheck": "tsc --noEmit",
    "typecheck:ts5": "bun --bun ./node_modules/typescript-5/lib/tsc.js --noEmit",
    "typecheck:jsr": "DENO_BIN_PATH=$PWD/node_modules/.bin/deno bunx --no-install jsr publish --dry-run --allow-dirty",
    "bench:types": "bun ./scripts/stress.ts",
    "fuzz": "FUZZ_RUNS=20000 bun test ./test/Fuzz.test.ts",
    "format": "bunx --no-install oxfmt .",
    "test": "bun run typecheck && bun run typecheck:ts5 && bun run typecheck:jsr && bun test",
    "verify": "bun run build && bun run test"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@ghostry/harness": "^0.0.7",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@rslib/core": "^1.0.2",
    "@types/bun": "1.4.4",
    "deno": "2.9.6",
    "jsr": "^0.14.3",
    "npm": "^12.1.0",
    "oxfmt": "^0.70.0",
    "recheck": "^4.6.2",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@^5.9.3"
  }
}
